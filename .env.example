# LLM — get a key at https://openrouter.ai/keys (free models available)
OPENROUTER_API_KEY=sk-or-...

# Qdrant — local Docker: http://localhost:6333, no key needed
# Qdrant Cloud: https://xxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis — local Docker: redis://localhost:6379
# Upstash: rediss://default:<token>@<host>:<port>
REDIS_URL=redis://localhost:6379

# Langfuse — optional, leave empty to disable tracing
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# SQLite path (relative to project root)
DATABASE_PATH=cost_tracking.db
